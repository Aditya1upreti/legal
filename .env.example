# Environment variables for Business Legal Assistant

# Google Sheets/Drive API
GOOGLE_SERVICE_ACCOUNT_PATH = credentials/service_account.json  # Path to service account JSON

# Gemini API
GEMINI_API_KEY = ""  # Google Generative AI API key for Gemini generation

# Qdrant vector database
QDRANT_URL = http://localhost:6333  # Qdrant server URL

# Neo4j graph database
NEO4J_URI = bolt://localhost:7687  # Neo4j bolt URI
NEO4J_USER = neo4j  # Neo4j username
NEO4J_PASSWORD =  # Neo4j password

# Optional: batch processing
BATCH_QUESTIONS_FILE = scripts/test_questions.txt  # Path to batch questions file